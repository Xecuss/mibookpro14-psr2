From: PSR2 investigation <psr2-test@local>
Subject: [PATCH] 0006-HACK-add-xe.psr2_su_y_alignment-experiment

Opt-in vertical selective-update grid, default 0 (native). Apply inside
the existing pipe alignment loop, before plane areas, retaining cursor
coverage. Request must respect native alignment and divide mode height.
104 was inferred from Windows bottom [1976,2080) captures, not read from
a Windows granularity setting. Both 104 and 80 passed tested Linux
scenarios; root cause remains unresolved. No timing or ALPM changes.

Local workaround/instrumentation; not an upstream submission.
---
diff --git a/drivers/gpu/drm/i915/display/intel_display_params.h b/drivers/gpu/drm/i915/display/intel_display_params.h
--- a/drivers/gpu/drm/i915/display/intel_display_params.h
+++ b/drivers/gpu/drm/i915/display/intel_display_params.h
@@ -51,6 +51,7 @@
 	param(int, psr2_idle_frames, -1, 0400) \
 	param(bool, vrr_ctl_bit26, false, 0400) \
 	param(int, psr2_su_area_max_lines, -1, 0400) \
+	param(int, psr2_su_y_alignment, 0, 0400) \
 	param(bool, enable_psr2_sel_fetch, true, 0400) \
 	param(int, enable_dmc_wl, -1, 0400) \
 
diff --git a/drivers/gpu/drm/i915/display/intel_display_params.c b/drivers/gpu/drm/i915/display/intel_display_params.c
--- a/drivers/gpu/drm/i915/display/intel_display_params.c
+++ b/drivers/gpu/drm/i915/display/intel_display_params.c
@@ -131,6 +131,10 @@
 	"Force full-frame PSR2 update when SU area height exceeds N lines "
 	"(-1=off [default], 0=always full frame, N=max SU lines)");
 
+intel_display_param_named_unsafe(psr2_su_y_alignment, int, 0400,
+	"Experimental selective-update vertical grid in lines "
+	"(0=native [default], positive=native-aligned divisor of mode height)");
+
 intel_display_param_named_unsafe(enable_panel_replay, int, 0400,
 	"Enable Panel Replay (0=disabled, 1=enabled). Default: -1 (use per-chip default)");
 
diff --git a/drivers/gpu/drm/i915/display/intel_psr.c b/drivers/gpu/drm/i915/display/intel_psr.c
--- a/drivers/gpu/drm/i915/display/intel_psr.c
+++ b/drivers/gpu/drm/i915/display/intel_psr.c
@@ -2779,6 +2779,8 @@
 {
 	struct intel_display *display = to_intel_display(crtc_state);
 	const struct drm_dsc_config *vdsc_cfg = &crtc_state->dsc.config;
+	int requested = display->params.psr2_su_y_alignment;
+	int height = crtc_state->hw.adjusted_mode.crtc_vdisplay;
 	u16 y_alignment;
 	bool su_area_changed = false;
 
@@ -2788,6 +2790,24 @@
 		y_alignment = vdsc_cfg->slice_height;
 	else
 		y_alignment = crtc_state->su_y_granularity;
+
+	/*
+	 * Experiment with a coarser grid while retaining selective update.
+	 * Preserve the native sink/DSC alignment and require a whole number
+	 * of bands so rounding up never crosses the bottom of the mode.
+	 * This runs inside the ET alignment loop, before plane SF areas are
+	 * derived, so newly intersected cursors and all planes are covered.
+	 */
+	if (requested) {
+		if (y_alignment && requested >= y_alignment &&
+		    requested <= height && requested % y_alignment == 0 &&
+		    height % requested == 0)
+			y_alignment = requested;
+		else
+			drm_info_once(display->drm,
+				      "Ignoring PSR SU y alignment %d (native %u, height %d)\n",
+				      requested, y_alignment, height);
+	}
 
 	if (crtc_state->psr2_su_area.y1 % y_alignment) {
 		crtc_state->psr2_su_area.y1 -= crtc_state->psr2_su_area.y1 % y_alignment;
diff --git a/drivers/gpu/drm/i915/display/intel_display_debugfs.c b/drivers/gpu/drm/i915/display/intel_display_debugfs.c
--- a/drivers/gpu/drm/i915/display/intel_display_debugfs.c
+++ b/drivers/gpu/drm/i915/display/intel_display_debugfs.c
@@ -569,6 +569,10 @@
 		   str_yes_no(crtc_state->dither), crtc_state->pipe_bpp);
 	seq_printf(m, "\tport_clock=%d, lane_count=%d\n",
 		   crtc_state->port_clock, crtc_state->lane_count);
+	seq_printf(m, "\tPSR SU: native_y_granularity=%u, requested_y_alignment=%d, DSC=%s\n",
+		   crtc_state->su_y_granularity,
+		   display->params.psr2_su_y_alignment,
+		   str_yes_no(crtc_state->dsc.compression_enable));
 
 	intel_scaler_info(m, crtc);
 
